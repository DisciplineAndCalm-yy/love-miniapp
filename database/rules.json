{
  "_comment": "思路文档（Firebase 风格）。生产请用 rules.wechat.json 在云开发控制台配置。",
  "users": {
    ".read": "doc._openid == auth.openid",
    ".write": false
  },
  "couples": {
    ".read": "auth.openid != null && doc.memberOpenids.includes(auth.openid)",
    ".write": false
  },
  "checkins": {
    ".read": "auth.openid != null && get(`database.couples.${doc.coupleId}`).memberOpenids.includes(auth.openid)",
    ".write": false
  },
  "posts": {
    ".read": "auth.openid != null && get(`database.couples.${doc.coupleId}`).memberOpenids.includes(auth.openid)",
    ".write": false
  },
  "anniversaries": {
    ".read": "auth.openid != null && get(`database.couples.${doc.coupleId}`).memberOpenids.includes(auth.openid)",
    ".write": false
  },
  "chats": {
    ".read": "auth.openid != null && get(`database.couples.${doc.coupleId}`).memberOpenids.includes(auth.openid)",
    ".write": false
  },
  "chatReads": {
    ".read": "auth.openid != null && get(`database.couples.${doc.coupleId}`).memberOpenids.includes(auth.openid)",
    ".write": false
  },
  "draws": {
    ".read": "auth.openid != null && get(`database.couples.${doc.coupleId}`).memberOpenids.includes(auth.openid)",
    ".write": false
  }
}
