<view class="page wish-page">
  <view class="wish-bg">
    <text class="float-heart fh1">🌟</text>
    <text class="float-heart fh2">✨</text>
    <text class="float-heart fh3">💫</text>
    <text class="float-heart fh4">🌙</text>
  </view>

  <view class="bottle-card">
    <view class="pill">🍾 两人互动 · 心愿漂流瓶</view>
    <image class="bottle {{drawing ? 'shaking' : ''}}" src="/assets/deco/bottle.svg" mode="aspectFit" />
    <view class="muted tip">写下小心愿丢进海里，TA 会捞到并帮你实现 ♡</view>
    <view class="sea"><text class="wave w1">🌊</text><text class="wave w2">🌊</text></view>
  </view>

  <view class="card">
    <view class="row-title">✏️ 写一个心愿</view>
    <view class="type-row">
      <view class="type {{kind==='wish'?'on':''}}" data-k="wish" bindtap="pickKind"><text class="type-icon">🌟</text><text>许愿</text></view>
      <view class="type {{kind==='todo'?'on':''}}" data-k="todo" bindtap="pickKind"><text class="type-icon">📝</text><text>待办</text></view>
      <view class="type {{kind==='gift'?'on':''}}" data-k="gift" bindtap="pickKind"><text class="type-icon">🎁</text><text>索礼</text></view>
    </view>
    <textarea class="field area" placeholder="比如：想一起去海边看日出 🌅" value="{{content}}" bindinput="onContent" maxlength="120" cursor-spacing="80" />
    <button class="btn-primary" bindtap="throwBottle" loading="{{throwing}}" disabled="{{throwing}}">🌊 丢进大海</button>
  </view>

  <view class="card">
    <view class="row-title">🌊 海面上的瓶子（{{unfinished}} 个待实现）</view>
    <view class="muted" wx:if="{{loading}}">正在打捞…</view>
    <view class="muted" wx:elif="{{!list.length}}">大海空空如也，快丢第一个瓶子 ✨</view>
    <view class="wish-item {{item.done ? 'done' : ''}}" wx:for="{{list}}" wx:key="_id">
      <text class="wish-icon">{{item.icon}}</text>
      <view class="wish-body">
        <view class="wish-text">{{item.content}}</view>
        <view class="muted">{{item.byName}} 丢出 · {{item.time}}{{item.done ? ' · 已实现 ✓' : ''}}</view>
      </view>
      <button class="btn-ghost done-btn" wx:if="{{!item.done}}" data-id="{{item._id}}" bindtap="grant">💫 帮TA实现</button>
      <text class="done-stamp" wx:else>🌟</text>
    </view>
  </view>

  <view class="grant-mask" wx:if="{{showGrant}}" bindtap="closeGrant">
    <view class="grant-card" catchtap="closeGrant">
      <text class="burst" wx:for="{{particles}}" wx:key="id" style="left:{{item.x}}%;font-size:{{item.s}}rpx;animation-duration:{{item.d}}s;animation-delay:{{item.delay}}s;">{{item.t}}</text>
      <view class="grant-face">🌟</view>
      <view class="title">心愿实现了！</view>
      <view class="grant-text">“{{grantText}}”</view>
      <view class="muted">TA 一定超开心，快去抱抱 ♡</view>
      <button class="btn-primary" bindtap="closeGrant" style="margin-top:26rpx">好 ♡</button>
    </view>
  </view>
</view>
