.tl-page{padding-bottom:160rpx}
.tl-hero{display:flex;align-items:center;gap:18rpx;background:linear-gradient(135deg,#FFE9EE,#FFF6F1 60%,#FFF4D9);border-radius:36rpx;padding:24rpx 26rpx;margin-bottom:20rpx;border:2rpx solid #fff;outline:2rpx solid var(--line);outline-offset:-2rpx;box-shadow:var(--shadow);position:relative;overflow:hidden;}
.tl-hero-art{width:110rpx;height:110rpx;flex-shrink:0;animation:float 3.4s ease-in-out infinite;}
.tl-hero-title{font-size:36rpx;font-weight:800;}
.tl-hero-heart{position:absolute;right:22rpx;top:14rpx;font-size:40rpx;opacity:.85;animation:float 3s ease-in-out infinite;}
.tags{white-space:nowrap;margin-bottom:20rpx}
.tag{display:inline-block;background:#fff;border:2rpx solid #F0DDE1;color:#9A7F82;border-radius:999rpx;padding:11rpx 26rpx;margin-right:14rpx;font-size:25rpx;font-weight:700;box-shadow:var(--shadow-sm);}
.tag:active{transform:scale(.93);}
.tag.on{background:linear-gradient(135deg,#FF8A9C,#E14E68);border-color:#fff;color:#fff;box-shadow:0 10rpx 22rpx rgba(232,106,122,.35);}
.center{text-align:center;padding:60rpx 20rpx}
.empty-art{width:220rpx;height:176rpx;margin:0 auto 10rpx;}
.empty-card{overflow:hidden;}
.tl{position:relative;padding-left:36rpx}
.tl-item{position:relative;padding-bottom:28rpx;animation:slideIn .35s ease;}
.tl-dot{position:absolute;left:0;top:34rpx;width:20rpx;height:20rpx;border-radius:50%;background:#E86A7A;box-shadow:0 0 0 8rpx #FBE3E8;z-index:2;}
.tl-dot.me{background:#6ABF69;box-shadow:0 0 0 8rpx #DFF2DF;}
.tl-line{position:absolute;left:9rpx;top:60rpx;bottom:0;width:2rpx;background:linear-gradient(180deg,#F5B3BE,#F0DDE1);}
.tl-item:last-child .tl-line{display:none}
.tl-card{background:#fff;border-radius:28rpx;padding:28rpx 28rpx 28rpx 96rpx;margin-left:28rpx;box-shadow:0 8rpx 30rpx rgba(232,106,122,.1);position:relative;overflow:hidden;border:2rpx solid #FFF1EC;transition:transform .15s ease;}
.tl-card:active{transform:scale(.98);}
.doing-badge{position:absolute;left:22rpx;top:26rpx;width:56rpx;height:56rpx;border-radius:50%;background:linear-gradient(180deg,#FFE9EE,#FFF6F1);border:2rpx solid var(--line);font-size:34rpx;text-align:center;line-height:56rpx;box-shadow:var(--shadow-sm);}
.tl-head{display:flex;justify-content:space-between;align-items:center}
.doing{font-weight:800;color:#D14E64;font-size:29rpx;}
.time{font-size:23rpx;color:#B79A9E;background:#FFF6F1;padding:4rpx 14rpx;border-radius:999rpx;}
.tl-author{font-size:24rpx;color:#B79A9E;margin:6rpx 0}
.tl-author::before{content:"✎ ";}
.tl-content{font-size:29rpx;line-height:1.7;margin:8rpx 0}
.pics{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx}
.pic{width:190rpx;height:190rpx;border-radius:18rpx;border:2rpx solid #fff;box-shadow:var(--shadow-sm);}
.fab{position:fixed;right:36rpx;bottom:120rpx;width:120rpx;height:120rpx;border-radius:50%;background:linear-gradient(135deg,#FF8A9C,#E14E68);border:4rpx solid #fff;box-shadow:0 14rpx 32rpx rgba(232,106,122,.45),inset 0 2rpx 0 rgba(255,255,255,.5);display:flex;flex-direction:column;align-items:center;justify-content:center;animation:fabPulse 2.4s infinite;z-index:60;}
.fab:active{transform:scale(.9);}
.fab-icon{font-size:48rpx;line-height:1;}
.fab-plus{font-size:22rpx;font-weight:800;color:#fff;line-height:1.4;}
.fab::after{border:none;}
@keyframes slideIn{from{opacity:0;transform:translateX(24rpx);}to{opacity:1;transform:none;}}
@keyframes fabPulse{0%,100%{box-shadow:0 14rpx 32rpx rgba(232,106,122,.45);}50%{box-shadow:0 14rpx 32rpx rgba(232,106,122,.45),0 0 0 18rpx rgba(232,106,122,.12);}}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10rpx);}}
