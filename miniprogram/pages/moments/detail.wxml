<view class="page"><view wx:if="{{detail}}" class="card detail-card">
<view class="head"><text class="doing-big">{{icon}}</text><view><view class="doing">{{detail.doing}}</view><text class="muted">{{time}}</text></view></view>
<view class="author">✎ {{detail.author ? detail.author.nickName : ''}}</view>
<view wx:if="{{detail.content}}" class="content">{{detail.content}}</view>
<image wx:for="{{detail.photos}}" wx:key="*this" src="{{detail.photoUrls[item] || item}}" mode="widthFix" class="big" data-src="{{detail.photoUrls[item] || item}}" bindtap="preview" />
<button class="btn-ghost del-btn" bindtap="remove" wx:if="{{mine}}">🗑 删除这条</button>
<view class="muted ta-note" wx:else>💌 这是 TA 的回忆，只能看不能动哦</view>
</view>

<view wx:if="{{detail}}" class="card interact-card">
  <view class="interact-bar">
    <view class="i-btn {{likedByMe ? 'on' : ''}}" bindtap="toggleLike">
      <text class="i-icon">{{likedByMe ? '❤️' : '🤍'}}</text><text class="i-txt">{{likeCount}}</text>
    </view>
    <view class="i-btn"><text class="i-icon">💬</text><text class="i-txt">{{comments.length}}</text></view>
  </view>

  <view class="reaction-bar">
    <view wx:for="{{quickEmojis}}" wx:key="*this" class="reaction-btn" data-emoji="{{item}}" bindtap="toggleReaction">
      <text class="reaction-emoji">{{item}}</text>
    </view>
  </view>
  <view class="reaction-summary" wx:if="{{reactions.length}}">
    <view class="rs-chip {{item.mine ? 'on' : ''}}" wx:for="{{reactions}}" wx:key="emoji" data-emoji="{{item.emoji}}" bindtap="toggleReaction">
      {{item.emoji}} {{item.count}}
    </view>
  </view>

  <view class="cmt-list">
    <view class="cmt" wx:for="{{comments}}" wx:key="_id" data-id="{{item._id}}" data-name="{{item.byName}}" bindtap="onReply">
      <view class="cmt-head">
        <text class="cmt-name">{{item.byName}}</text>
        <text wx:if="{{item.replyToName}}" class="cmt-reply">回复 @{{item.replyToName}}</text>
        <text class="cmt-time">{{item.timeText}}</text>
        <text wx:if="{{item.isMine}}" class="cmt-del" data-id="{{item._id}}" catchtap="removeComment">删除</text>
      </view>
      <view class="cmt-text">{{item.content}}</view>
    </view>
    <view class="cmt-empty muted" wx:if="{{!comments.length}}">还没有评论，说点什么吧 ♡</view>
  </view>

  <view class="reply-bar" wx:if="{{replyTo.id}}">
    <text class="reply-txt">回复 @{{replyTo.name}}</text>
    <text class="reply-cancel" bindtap="cancelReply">取消</text>
  </view>
  <view class="cmt-input-row">
    <text class="at-btn" bindtap="onAt">@TA</text>
    <input class="cmt-input" value="{{commentInput}}" bindinput="onCommentInput" placeholder="{{replyTo.id ? ('回复 @' + replyTo.name) : '写下你的评论…'}}" maxlength="200" confirm-type="send" bindconfirm="sendComment" cursor-spacing="24" />
    <button class="btn-primary cmt-send" bindtap="sendComment" loading="{{sending}}" disabled="{{sending}}">发送</button>
  </view>
</view>
</view>
