.cute-hero { padding-bottom: 40rpx; }
.hero-deco { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 120rpx; opacity: .85; }
.couple-line { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; font-weight: 800; font-size: 35rpx; }
.couple-line .who { background: rgba(255,255,255,.9); padding: 8rpx 24rpx; border-radius: 999rpx; border: 2rpx solid #fff; box-shadow: var(--shadow-sm); }
.couple-line .plus { background: linear-gradient(135deg,#FF8A9C,#EF5E7C); border-radius: 50%; width: 54rpx; height: 54rpx; text-align: center; line-height: 54rpx; color: #fff; border: 2rpx solid #fff; box-shadow: 0 8rpx 18rpx rgba(239,94,124,.4); }
.days { display: flex; align-items: baseline; gap: 10rpx; margin-top: 10rpx; }
.days .num { font-size: 156rpx; font-weight: 900; line-height: 1; background: linear-gradient(180deg,#E14E68,#B23A52); -webkit-background-clip: text; background-clip: text; color: transparent; letter-spacing: -4rpx; filter: drop-shadow(2rpx 3rpx 0 #fff); }
.days .unit { font-size: 34rpx; font-weight: 800; color: #A98385; background: #fff; border-radius: 999rpx; padding: 4rpx 20rpx; border: 2rpx solid var(--line); }
.hero-sub { font-size: 28rpx; margin: 10rpx 0 8rpx; color: #7A5257; font-weight: 600; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; position: relative; z-index: 2; align-items: center; }
.mascot-wrap { position: static; width: 96rpx; height: 96rpx; max-width: 96rpx; max-height: 96rpx; overflow: hidden; flex-shrink: 0; margin-left: auto; animation: float 3.4s ease-in-out infinite; }
.mascot { display: block; width: 96rpx; height: 96rpx; max-width: 96rpx; max-height: 96rpx; filter: drop-shadow(0 12rpx 16rpx rgba(209,78,100,.25)); }
.mascot-fallback { display: block; width: 96rpx; height: 96rpx; font-size: 72rpx; text-align: center; line-height: 96rpx; }
.mini-wrap { position: relative; width: 128rpx; height: 128rpx; font-size: 82rpx; text-align: center; line-height: 128rpx; flex-shrink: 0; background: linear-gradient(180deg,#FFE9EE,#FFF6F1); border-radius: 36rpx; border: 2rpx solid #fff; box-shadow: var(--shadow-sm); overflow: hidden; }
.mini-wrap image { position: absolute; left: 0; top: 0; width: 128rpx; height: 128rpx; }
.row-title { font-size: 31rpx; font-weight: 800; margin-bottom: 22rpx; display: flex; align-items: center; gap: 10rpx; }
.row-title::before { content: ""; width: 10rpx; height: 30rpx; border-radius: 999rpx; background: linear-gradient(180deg,#FF9EB2,#EF5E7C); display: inline-block; }
.status-row { display: flex; gap: 14rpx; margin-bottom: 22rpx; align-items: stretch; }
.status { flex: 1; border-radius: 30rpx; padding: 24rpx; min-height: 156rpx; border: 2rpx solid #fff; box-shadow: var(--shadow-sm); }
.status.me { background: linear-gradient(180deg, #FFE9EE, #FFF7F3); outline: 2rpx solid #F9DCDD; outline-offset: -2rpx; }
.status.ta { background: linear-gradient(180deg, #FFF4D9, #FFFBEE); outline: 2rpx solid #F0DFAE; outline-offset: -2rpx; }
.who-tag { font-weight: 800; font-size: 26rpx; background: #fff; display: inline-block; padding: 7rpx 20rpx; border-radius: 999rpx; box-shadow: 0 4rpx 10rpx rgba(0,0,0,.07); }
.heart-mid { align-self: center; background: linear-gradient(135deg,#FF8A9C,#E14E68); color: #fff; width: 60rpx; height: 60rpx; border-radius: 50%; text-align: center; line-height: 60rpx; border: 3rpx solid #fff; box-shadow: 0 10rpx 20rpx rgba(239,94,124,.45); animation: beat 1.6s infinite; flex-shrink: 0; }
.status-body { margin-top: 12rpx; font-size: 27rpx; line-height: 1.6; }
.anni { font-size: 37rpx; font-weight: 800; margin-bottom: 8rpx; }
.anni-row{display:flex;align-items:center;gap:18rpx;}
.anni-emoji-big{font-size:76rpx;line-height:1;filter:drop-shadow(0 8rpx 10rpx rgba(209,78,100,.25));animation:float 3s ease-in-out infinite;flex-shrink:0;}
.anni-info{flex:1;min-width:0;}
.count-pill{flex-shrink:0;font-size:26rpx;font-weight:900;color:#fff;background:linear-gradient(135deg,#FF8A9C,#E14E68);border-radius:999rpx;padding:12rpx 26rpx;border:2rpx solid #fff;box-shadow:0 10rpx 22rpx rgba(232,106,122,.4);animation:beat 2s infinite;}
.cute-anni { background: linear-gradient(180deg, #fff 30%, #FFF4D9); }
.anni-card:active { opacity: .93; transform: scale(.99); }
.link { color: var(--rose-deep); font-size: 23rpx; font-weight: 800; background: rgba(255,255,255,.92); padding: 8rpx 18rpx; border-radius: 999rpx; border: 2rpx solid var(--line); box-shadow: var(--shadow-sm); }
.link:active { transform: scale(.94); }
.streak-line { margin-bottom: 22rpx; background: #fff; display: inline-block; padding: 9rpx 22rpx; border-radius: 999rpx; border: 2rpx dashed #F5B3BE; font-weight: 600; }
.pet-banner { display: flex; align-items: center; gap: 26rpx; background: linear-gradient(120deg,#fff 55%,#E9F6EC 100%); padding: 30rpx 28rpx; }
.pet-banner:active { transform: scale(.99); }
.mini-wrap { width: 128rpx; height: 128rpx; line-height: 128rpx; }
.mini-wrap image, .mini-pet { width: 128rpx; height: 128rpx; }
.chev { margin-left: auto; color: var(--rose); font-weight: 900; background: var(--blush); width: 60rpx; height: 60rpx; border-radius: 50%; text-align: center; line-height: 60rpx; }
.weather-card { background: linear-gradient(120deg,#fff 45%,#DCE9FB 120%); }
.weather-card:active { transform: scale(.99); }
.wx-top { display: flex; align-items: center; gap: 22rpx; }
.wx-emoji { font-size: 74rpx; filter: drop-shadow(0 8rpx 12rpx rgba(80,120,180,.25)); flex-shrink: 0; }
.wx-info { flex: 1; min-width: 0; }
.wx-city { font-size: 27rpx; font-weight: 800; color: #4A6A9A; }
.wx-temp { font-size: 40rpx; font-weight: 900; color: #3A5A8C; margin-top: 4rpx; }
.wx-desc { font-size: 26rpx; font-weight: 700; color: #463035; margin-left: 8rpx; }
.wx-praise {
  margin-top: 20rpx; font-size: 27rpx; font-weight: 700; line-height: 1.6; color: #C9405A;
  background: #FFF0F4; border-radius: 24rpx; padding: 18rpx 22rpx; border: 2rpx solid #F9DCDD;
}
@keyframes beat { 0%,100% { transform: scale(1); } 30% { transform: scale(1.16); } 60% { transform: scale(1); } }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12rpx); } }

/* 消息中心入口 */
.notice-entry{display:flex;align-items:center;gap:16rpx;}
.ne-icon{width:72rpx;height:72rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:38rpx;border-radius:22rpx;background:linear-gradient(135deg,#FFE9EE,#FFF3F4);border:2rpx solid var(--line);}
.ne-body{flex:1;min-width:0;}
.ne-title{font-size:30rpx;font-weight:800;display:flex;align-items:center;gap:10rpx;}
.ne-badge{min-width:34rpx;height:34rpx;line-height:34rpx;padding:0 10rpx;border-radius:999rpx;background:#FF5A78;color:#fff;font-size:22rpx;font-weight:800;text-align:center;box-shadow:0 6rpx 14rpx rgba(255,90,120,.4);}

/* ===== 功能宫格 ===== */
.fn-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx 12rpx;margin-bottom:22rpx;}
.fn-item{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:18rpx 0 16rpx;background:#fff;border-radius:24rpx;border:2rpx solid var(--line);box-shadow:var(--shadow-sm);transition:transform .16s ease;position:relative;}
.fn-item:active{transform:scale(.94);}
.fn-ico{width:78rpx;height:78rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;background:radial-gradient(circle at 30% 25%,#FFF8F4,#FFE9EE);box-shadow:inset 0 2rpx 6rpx rgba(255,255,255,.85),0 6rpx 12rpx rgba(232,128,148,.12);}
.fn-label{font-size:23rpx;font-weight:700;color:#6b5560;}
.fn-group{margin-bottom:10rpx;}
.fn-group-head{display:flex;align-items:center;gap:10rpx;margin:10rpx 6rpx 14rpx;}
.fg-emoji{font-size:28rpx;}
.fg-title{font-size:27rpx;font-weight:800;color:#5C4448;}
.fg-count{font-size:20rpx;color:#B79A9E;background:#F7EEF0;border-radius:999rpx;padding:2rpx 14rpx;font-weight:700;}
.fg-caret{margin-left:auto;font-size:24rpx;color:#C79AA1;}
.fn-edit-bar{display:flex;align-items:center;gap:10rpx;margin:4rpx 4rpx 6rpx;}
.feb-title{font-size:28rpx;font-weight:800;color:#5C4448;}
.feb-hint{font-size:21rpx;color:#C0A3A7;}
.feb-btn{margin-left:auto;font-size:24rpx;font-weight:800;color:#fff;background:linear-gradient(135deg,#FF8A9C,#E14E68);border-radius:999rpx;padding:8rpx 24rpx;box-shadow:0 6rpx 14rpx rgba(225,78,104,.26);}
.fn-item.off{opacity:.42;border-style:dashed;}
.fn-mark{position:absolute;top:8rpx;right:10rpx;width:32rpx;height:32rpx;line-height:30rpx;text-align:center;font-size:22rpx;color:#fff;background:#E36A82;border-radius:50%;font-weight:700;}
.fn-collapsed-tip{margin:0 6rpx 18rpx;font-size:22rpx;color:#C0A3A7;}
.fn-reset{margin:6rpx auto 8rpx;text-align:center;font-size:24rpx;font-weight:700;color:#B0797F;text-decoration:underline;}
.fn-edit-tip{margin:2rpx 6rpx 10rpx;font-size:21rpx;color:#C0A3A7;text-align:center;}
.fn-item.dragging{opacity:.32;border-style:dashed;transform:scale(.96);}
.drag-ghost{position:fixed;z-index:999;width:152rpx;padding:16rpx 0 14rpx;display:flex;flex-direction:column;align-items:center;gap:8rpx;background:#fff;border-radius:24rpx;border:2rpx solid #F7C7D3;box-shadow:0 18rpx 40rpx rgba(225,78,104,.28);transform:scale(1.06);pointer-events:none;}
.drag-ghost .fn-ico{width:78rpx;height:78rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;}
.drag-ghost .fn-label{font-size:23rpx;font-weight:700;color:#6b5560;}
.fn-more .fn-ico{background:linear-gradient(135deg,#FFE1E7,#FFD0DA);color:#D14E64;font-weight:900;}
.gi-checkin{background:linear-gradient(135deg,#FFEFC2,#FFD36E);}
.gi-moments{background:linear-gradient(135deg,#FFD3DE,#FF9FB2);}
.gi-album{background:linear-gradient(135deg,#CFE6FF,#8CC5FF);}
.gi-intimacy{background:linear-gradient(135deg,#FFC9D4,#FF8A9C);}
.gi-life{background:linear-gradient(135deg,#CFF2D6,#8FE0A2);}
.gi-blog{background:linear-gradient(135deg,#E9DDFF,#C6A8FF);}
.gi-chat{background:linear-gradient(135deg,#CFEDFF,#8FD4FF);}

/* ===== 到期提醒条 ===== */
.reminder-strip{display:flex;flex-direction:column;gap:12rpx;margin-bottom:20rpx;}
.rs-item{font-size:25rpx;font-weight:700;border-radius:18rpx;padding:18rpx 24rpx;transition:transform .16s ease;}
.rs-item:active{transform:scale(.98);}
.rs-item.warn{color:#C9772A;background:#FFF3E0;border:2rpx solid #FAD9A8;}
.rs-item.gift{color:#7A5BB5;background:linear-gradient(135deg,#F3ECFF,#E9DDFF);border:2rpx solid #DED2F6;}

.home-pendant{position:absolute;right:28rpx;top:24rpx;font-size:64rpx;filter:drop-shadow(0 6rpx 12rpx rgba(0,0,0,.25));animation:pop 2.6s ease-in-out infinite;z-index:5;}
