<view class="page" style="background: {{themeBg}};">
  <view class="sk-overlay" wx:if="{{!ready}}" style="background: {{themeBg}};">
    <view class="sk-hero sk-shimmer"></view>
    <view class="sk-grid">
      <view class="sk-card sk-shimmer"></view>
      <view class="sk-card sk-shimmer"></view>
    </view>
    <view class="sk-card sk-shimmer" style="height:190rpx;"></view>
    <view class="sk-card sk-shimmer" style="height:150rpx;"></view>
    <view class="sk-tip">正在打开两个人的小宇宙…</view>
  </view>
  <view class="hero cute-hero" wx:if="{{paired}}" style="background: linear-gradient(160deg, {{themeBg}} 0%, {{themeAccent}}33 100%);">
    <image class="hero-deco" src="/assets/deco/hearts.svg" mode="aspectFit" binderror="hideDeco" wx:if="{{showDeco}}" />
    <text wx:if="{{pendantEmoji}}" class="home-pendant">{{pendantEmoji}}</text>
    <view class="pill">♥ 只属于两个人的小宇宙 ♥</view>
    <view class="couple-line">
      <text class="who">{{myName}}</text>
      <text class="plus">＋</text>
      <text class="who">{{partnerName}}</text>
    </view>
    <view class="days"><text class="num">{{days}}</text><text class="unit">天</text></view>
    <view class="hero-sub">♡ 在一起的每一天都值得纪念 ♡</view>
    <view class="muted" wx:if="{{togetherSince}}">从 {{togetherSince}} 开始</view>
  </view>

  <view class="hero cute-hero" wx:else>
    <image class="hero-deco" src="/assets/deco/hearts.svg" mode="aspectFit" binderror="hideDeco" wx:if="{{showDeco}}" />
    <view class="pill">♥ 还没有绑定 ♥</view>
    <view class="title" style="margin-top: 20rpx;">先把 TA 接进来吧 ~</view>
    <view class="muted" style="margin: 14rpx 0 28rpx;">生成邀请码，或输入对方的码，两个人就共用一个小家啦 🏡</view>
    <button class="btn-primary" bindtap="goBind">去绑定 ♡</button>
  </view>

  <view class="card notice-entry" wx:if="{{paired}}" bindtap="goNotify">
    <text class="ne-icon">🔔</text>
    <view class="ne-body">
      <view class="ne-title">消息中心<text class="ne-badge" wx:if="{{unreadNotice}}">{{unreadNotice}}</text></view>
      <view class="muted">{{unreadNotice ? ('有 ' + unreadNotice + ' 条新互动，快去看看 TA') : 'TA 的点赞、评论、签到和晚安'}}</view>
    </view>
    <text class="chev">〉</text>
  </view>

  <view class="reminder-strip" wx:if="{{paired && (reminders.dueTodos || reminders.capsuleReady)}}">
    <view class="rs-item warn" wx:if="{{reminders.dueTodos}}" bindtap="goLife">⏰ {{reminders.dueTodos}} 项待办今天到期或已逾期</view>
    <view class="rs-item gift" wx:if="{{reminders.capsuleReady}}" bindtap="goCapsule">💌 {{reminders.capsuleReady}} 个时间胶囊可拆啦</view>
  </view>

  <!-- 功能分区 -->
  <block wx:if="{{paired}}">
    <view class="fn-edit-bar">
      <text class="feb-title">快捷入口</text>
      <text class="feb-hint" wx:if="{{editing}}">点图标可隐藏 / 显示</text>
      <text class="feb-btn" bindtap="toggleEdit">{{editing ? '完成' : '编辑'}}</text>
    </view>

    <view class="fn-group" wx:for="{{viewGroups}}" wx:key="key">
      <view class="fn-group-head" data-key="{{item.key}}" bindtap="toggleCollapse">
        <text class="fg-emoji">{{item.emoji}}</text>
        <text class="fg-title">{{item.title}}</text>
        <text class="fg-count">{{item.items.length}}</text>
        <text class="fg-caret" wx:if="{{!editing}}">{{collapsed[item.key] ? '▸' : '▾'}}</text>
      </view>
      <view class="fn-grid" id="fg-{{item.key}}" wx:if="{{editing || !collapsed[item.key]}}">
        <view
          class="fn-item fgi-{{item.key}} {{hidden[it.to] ? 'off' : ''}} {{drag.active && drag.to === it.to ? 'dragging' : ''}}"
          wx:for="{{item.items}}"
          wx:for-item="it"
          wx:if="{{editing || !hidden[it.to]}}"
          wx:key="label"
          data-to="{{it.to}}"
          data-group="{{item.key}}"
          bindtap="onEntryTap"
          bindlongpress="onDragStart"
          bindtouchmove="onDragMove"
          bindtouchend="onDragEnd"
          bindtouchcancel="onDragEnd"
        >
          <view class="fn-ico" style="background: {{item.tint}};">{{it.icon}}</view>
          <text class="fn-label">{{it.label}}</text>
          <view class="fn-mark" wx:if="{{editing}}">{{hidden[it.to] ? '＋' : '✓'}}</view>
        </view>
      </view>
      <view class="fn-collapsed-tip" wx:if="{{!editing && collapsed[item.key]}}">已收起 · 点标题展开</view>
    </view>

    <view class="fn-edit-tip" wx:if="{{editing}}">长按图标可拖动排序 · 点击可隐藏/显示</view>
    <view class="fn-reset" wx:if="{{editing}}" bindtap="resetEntries">恢复默认</view>
  </block>

  <view class="drag-ghost" wx:if="{{drag.active}}" style="left:{{drag.x}}px;top:{{drag.y}}px;">
    <view class="fn-ico" style="background: {{drag.tint}};">{{drag.icon}}</view>
    <text class="fn-label">{{drag.label}}</text>
  </view>

  <view class="card" wx:if="{{paired}}">
    <view class="row-title">💌 今天的心情电报</view>
    <view class="status-row">
      <view class="status me">
        <view class="who-tag">{{myName}} 🐱</view>
        <view class="status-body" wx:if="{{myCheckin}}">{{moodMap[myCheckin.mood]}} · {{myCheckin.content || '已签到'}}</view>
        <view wx:else class="muted status-body">还没签到，快去盖章！</view>
      </view>
      <view class="heart-mid">♥</view>
      <view class="status ta">
        <view class="who-tag">{{partnerName}} 🐶</view>
        <view class="status-body" wx:if="{{partnerCheckin}}">{{moodMap[partnerCheckin.mood]}} · {{partnerCheckin.content || '已签到'}}</view>
        <view wx:else class="muted status-body">TA 还在路上…</view>
      </view>
    </view>
    <view class="streak-line muted">🔥 连续 {{streaks.mine}} 天 · 👫 两人同频 {{streaks.together}} 天</view>
    <button class="btn-ghost" bindtap="goCheckin">{{myCheckin ? '看看签到 ♡' : '去签到 ♡'}}</button>
  </view>

  <view class="card anni-card cute-anni" wx:if="{{paired}}" bindtap="goAnniversary">
    <text class="sticker" style="right:20rpx;top:14rpx">🎀</text>
    <view class="row-title">🎈 下一个纪念日</view>
    <block wx:if="{{nextDay}}">
      <view class="anni-row">
        <text class="anni-emoji-big">{{nextDay.emoji || '♡'}}</text>
        <view class="anni-info">
          <view class="anni">{{nextDay.title}}</view>
          <view class="muted">{{nextDay.next}}</view>
        </view>
        <view class="count-pill">{{nextDay.leftLabel}}</view>
      </view>
    </block>
    <view class="muted" wx:else>还没有纪念日，点这里许个愿吧 ✨</view>
  </view>

  <view class="card weather-card" wx:if="{{paired}}" bindtap="goWeather">
    <view class="wx-top">
      <text class="wx-emoji">{{weatherEmoji}}</text>
      <view class="wx-info">
        <view class="wx-city">📍 {{weather ? (weather.city || '当前城市') : '今日天气'}}</view>
        <view class="wx-temp" wx:if="{{weather}}">{{weather.now.temp}}° <text class="wx-desc">{{weather.now.text}}</text></view>
        <view class="muted" wx:else>点我设置城市，看天气和夸夸 ♡</view>
      </view>
      <text class="chev">〉</text>
    </view>
    <view class="wx-praise" wx:if="{{praise}}">💌 {{praise}}</view>
  </view>
</view>
