.mem-page { position: relative; padding: 20rpx 24rpx 70rpx; overflow: hidden; }

/* 背景装饰 */
.mem-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; z-index: 0; pointer-events: none; }
.mem-bg-img {
  position: absolute; top: -60rpx; right: -80rpx; width: 420rpx; height: 420rpx;
  opacity: .16; animation: spinSlow 40s linear infinite;
}

/* 漂浮粒子 */
.mem-particles { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.mem-particle {
  position: absolute; bottom: -50rpx; opacity: 0;
  animation-name: floatUpMem; animation-timing-function: ease-in-out; animation-iteration-count: infinite;
}

/* 标题 */
.mem-title-wrap { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; gap: 14rpx; margin: 8rpx 0 22rpx; }
.mem-title {
  font-size: 38rpx; font-weight: 900; letter-spacing: .06em;
  background: linear-gradient(90deg,#E14E68,#FF9F72,#C86BD6,#E14E68);
  background-size: 220% 100%;
  -webkit-background-clip: text; background-clip: text; color: transparent;
  animation: hueSlide 5s linear infinite;
}
.mem-spark { color: #FFB27A; font-size: 30rpx; animation: twinkle 2s ease-in-out infinite; }
.mem-spark.r { animation-delay: 1s; }

/* 卡片与画布 */
.mem-wrap { position: relative; z-index: 1; display: flex; justify-content: center; margin-bottom: 30rpx; }
.mem-glow {
  position: absolute; top: 50%; left: 50%; width: 78%; height: 82%; transform: translate(-50%, -50%);
  background: radial-gradient(closest-side, rgba(255,160,185,.5), rgba(255,200,150,.18), transparent);
  filter: blur(10rpx); border-radius: 50%; z-index: -1; animation: glowPulse 3.4s ease-in-out infinite;
}
.mem-canvas {
  border-radius: 32rpx; background: #FFF8FB;
  box-shadow: 0 26rpx 56rpx rgba(232,128,148,.32), 0 0 0 10rpx rgba(255,255,255,.65);
  animation: canvasIn .8s cubic-bezier(.16,1,.3,1) both, breathe 6s ease-in-out 0.8s infinite;
}

/* 按钮 */
.mem-save {
  position: relative; z-index: 2; overflow: hidden;
  box-shadow: 0 16rpx 30rpx rgba(225,78,104,.34);
}
.mem-save::after {
  content: ''; position: absolute; top: 0; left: -70%; width: 50%; height: 100%;
  background: linear-gradient(100deg, rgba(255,255,255,0), rgba(255,255,255,.6), rgba(255,255,255,0));
  transform: skewX(-18deg); animation: btnShine 3.2s ease-in-out infinite;
}
.mem-hint { position: relative; z-index: 2; text-align: center; font-size: 22rpx; color: #C0A3A7; margin-top: 16rpx; }
.mem-loading { position: relative; z-index: 2; padding-top: 120rpx; }
.empty-card { position: relative; z-index: 2; text-align: center; padding: 60rpx 30rpx; }
.empty-icon { font-size: 82rpx; display: block; margin-bottom: 12rpx; animation: floatUpSoft 3s ease-in-out infinite; }

@keyframes floatUpMem {
  0% { transform: translateY(0) scale(.6) rotate(-8deg); opacity: 0; }
  15% { opacity: .9; }
  80% { opacity: .5; }
  100% { transform: translateY(-1000rpx) scale(1.1) rotate(14deg); opacity: 0; }
}
@keyframes spinSlow { from { transform: rotate(0); } to { transform: rotate(360deg); } }
@keyframes hueSlide { 0% { background-position: 0% 50%; } 100% { background-position: 220% 50%; } }
@keyframes twinkle { 0%,100% { transform: scale(.8); opacity: .5; } 50% { transform: scale(1.2); opacity: 1; } }
@keyframes glowPulse { 0%,100% { transform: translate(-50%, -50%) scale(1); opacity: .7; } 50% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; } }
@keyframes canvasIn { 0% { opacity: 0; transform: translateY(30rpx) scale(.94); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes breathe { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
@keyframes btnShine { 0% { left: -70%; } 60%, 100% { left: 130%; } }
@keyframes floatUpSoft { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
