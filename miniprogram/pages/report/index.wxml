<import src="/templates/loading.wxml" />
<view class="page report-page">
  <template is="cute-loading" data="{{show: loading, text: '正在生成恋爱报告…'}}" />
  <view wx:if="{{loading}}" class="muted center">正在生成你们的恋爱报告… ♡</view>

  <block wx:elif="{{paired}}">
    <view class="poster">
      <view class="poster-deco" aria-hidden="true">
        <text class="pd pd1">❤️</text>
        <text class="pd pd2">✨</text>
        <text class="pd pd3">💕</text>
        <text class="pd pd4">🌸</text>
        <text class="pd pd5">💫</text>
      </view>
      <view class="p-top">♡ 我们的恋爱报告 ♡</view>
      <view class="p-couple">{{myName}}<text class="p-plus">＋</text>{{partnerName}}</view>
      <view class="p-days"><text class="p-days-num">{{days}}</text><text class="p-days-unit">天</text></view>
      <view class="p-since" wx:if="{{togetherSince}}">从 {{togetherSince}} 一起走到现在</view>
      <view class="p-level" wx:if="{{level}}">{{level.title}} · Lv.{{level.lv}}</view>

      <view class="p-stats">
        <view class="p-stat" wx:for="{{chips}}" wx:key="label">
          <text class="ps-icon">{{item.icon}}</text>
          <text class="ps-val">{{item.value}}</text>
          <text class="ps-label">{{item.label}}</text>
        </view>
      </view>

      <view class="p-moods" wx:if="{{moodDots.length}}">
        <view class="p-moods-title">最近的 {{moodDays}} 次心情</view>
        <view class="mood-dots">
          <text class="mood-dot {{item.mine ? 'mine' : 'partner'}}" wx:for="{{moodDots}}" wx:key="k">{{item.emoji}}</text>
        </view>
      </view>

      <view class="p-foot">在一起的第 {{days}} 天，也想一直和你走下去 ♡</view>
    </view>

    <button class="report-save" bindtap="savePoster">
      <text class="rs-heart rs-heart-a">💗</text>
      <text class="rs-heart rs-heart-b">✨</text>
      <text class="rs-ico">📸</text>
      <text class="rs-txt">保存 / 截屏收藏</text>
      <text class="rs-heart rs-heart-c">💖</text>
    </button>
    <view class="report-mood" hover-class="report-mood-hover" bindtap="goMoodBoard">
      <text class="rm-spark rm-spark-a">✨</text>
      <text class="rm-spark rm-spark-b">💕</text>
      <view class="rm-ico">📈</view>
      <view class="rm-body">
        <view class="rm-title">心情曲线 & 热力图</view>
        <view class="rm-sub">看看我们最近的情绪起伏 ♡</view>
      </view>
      <view class="rm-arrow">›</view>
    </view>
    <view class="report-hint">点右上角「···」可分享给 TA ♡</view>
  </block>

  <view wx:else class="card empty-card center">
    <text class="empty-icon">📖</text>
    <view class="title">先绑定两个人吧</view>
    <view class="muted">有了 TA，才有属于你们的报告 ♡</view>
  </view>
</view>
