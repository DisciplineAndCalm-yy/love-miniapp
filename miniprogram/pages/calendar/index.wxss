.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  width: 64rpx;
  text-align: center;
  font-size: 48rpx;
  color: #e86a7a;
}

.week,
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
}

.week {
  color: #9a7f82;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.cell {
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.cell.sel {
  background: #fff1ec;
}

.cell.today text {
  color: #e86a7a;
  font-weight: 600;
}

.dots {
  display: flex;
  gap: 6rpx;
  height: 12rpx;
  margin-top: 4rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.dot.pink { background: #e86a7a; }
.dot.gold { background: #d4a574; }

.legend {
  margin-top: 16rpx;
}

.line {
  margin-top: 16rpx;
}
