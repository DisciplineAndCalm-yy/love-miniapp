<view class="page">
  <view class="preview" style="background: linear-gradient(135deg, {{color}}, {{color}}CC);">
    <text class="preview-shine">✨</text>
    <text class="preview-shine s2">💫</text>
    <view class="preview-emoji">{{emoji}}</view>
    <view class="preview-title">{{title || '纪念日标题'}}</view>
    <view class="preview-date">📅 {{date}} {{repeatYearly ? '· 每年重复 ♻️' : ''}}</view>
    <view class="preview-note" wx:if="{{note}}">💬 {{note}}</view>
  </view>

  <view class="card">
    <view class="sec-mini">✏️ 起个名字</view>
    <input class="field" placeholder="标题，比如第一次见面" value="{{title}}" bindinput="onTitle" maxlength="20" cursor-spacing="80" />
    <view class="sec-mini">😊 选个符号</view>
    <view class="emoji-row">
      <view wx:for="{{emojiPresets}}" wx:key="*this" class="emoji-pick {{emoji === item ? 'on' : ''}}" data-e="{{item}}" bindtap="pickEmoji">{{item}}</view>
    </view>
    <input class="field" placeholder="或自己输入一个符号，比如 ♡" value="{{emoji}}" bindinput="onEmoji" maxlength="4" cursor-spacing="80" />
    <view class="sec-mini">📅 哪一天</view>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="field date-field">📅 {{date}}<text class="chev">〉</text></view>
    </picker>
    <view class="repeat-row">
      <text>♻️ 每年重复</text>
      <switch checked="{{repeatYearly}}" bindchange="onRepeat" color="#E86A7A" />
    </view>
    <view class="sec-mini">🎨 卡片颜色</view>
    <view class="colors">
      <view
        wx:for="{{colors}}"
        wx:key="*this"
        class="swatch {{color === item ? 'on' : ''}}"
        style="background: {{item}};"
        data-color="{{item}}"
        bindtap="onColor"
      ><text wx:if="{{color === item}}" class="swatch-check">✓</text></view>
    </view>
    <view class="sec-mini">💬 写在卡片上的话</view>
    <textarea class="field area" placeholder="比如：那天阳光正好，你笑得好甜" value="{{note}}" bindinput="onNote" maxlength="200" cursor-spacing="80" />
    <button class="btn-primary" bindtap="save">💾 保存卡片</button>
    <button class="btn-ghost" wx:if="{{id}}" bindtap="remove" style="margin-top:16rpx">🗑 删除这个纪念日</button>
  </view>
</view>
