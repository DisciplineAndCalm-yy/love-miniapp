.preview {
  color: #fff;
  border-radius: 36rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 24rpx;
  min-height: 260rpx;
  position: relative;
  overflow: hidden;
  border: 3rpx solid #fff;
  box-shadow: var(--shadow);
  animation: slideUp .35s ease;
}
.preview::after{content:"";position:absolute;right:-56rpx;bottom:-62rpx;width:200rpx;height:200rpx;border-radius:50%;background:rgba(255,255,255,.22);pointer-events:none;}
.preview-shine{position:absolute;left:30rpx;top:20rpx;font-size:40rpx;animation:twinkle 2s ease-in-out infinite;}
.preview-shine.s2{left:auto;right:34rpx;top:auto;bottom:30rpx;animation-delay:-1s;}
.preview-emoji{font-size:88rpx;line-height:1;filter:drop-shadow(0 8rpx 10rpx rgba(0,0,0,.2));animation:float 3s ease-in-out infinite;position:relative;z-index:1;}
.preview-title {
  font-size: 46rpx;
  font-weight: 800;
  margin: 14rpx 0 8rpx;
  position:relative;z-index:1;
  text-shadow:0 2rpx 8rpx rgba(0,0,0,.15);
}
.preview-date{font-size:27rpx;opacity:.95;position:relative;z-index:1;}
.preview-note {
  margin-top: 18rpx;
  background:rgba(255,255,255,.22);
  border:2rpx solid rgba(255,255,255,.5);
  border-radius:20rpx;
  padding:14rpx 20rpx;
  line-height: 1.6;
  position:relative;z-index:1;
}
.sec-mini{font-size:27rpx;font-weight:800;margin:6rpx 0 16rpx;display:flex;align-items:center;gap:8rpx;}
.sec-mini::before{content:"";width:8rpx;height:26rpx;border-radius:999rpx;background:linear-gradient(180deg,#FF9EB2,#EF5E7C);}
.emoji-row{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:18rpx;}
.emoji-pick{width:76rpx;height:76rpx;border-radius:24rpx;background:#FFFAF7;border:2rpx solid var(--line);font-size:40rpx;text-align:center;line-height:76rpx;}
.emoji-pick:active{transform:scale(.9);}
.emoji-pick.on{border-color:var(--rose);background:#fff;box-shadow:0 0 0 4rpx rgba(240,98,126,.2);transform:translateY(-4rpx);}
.date-field{display:flex;align-items:center;justify-content:space-between;font-weight:700;}
.date-field .chev{color:var(--rose);font-weight:900;}
.field {
  background: #fff8f5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  position:relative;z-index:5;
}
.area {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}
.colors {
  display: flex;
  gap: 18rpx;
  margin: 8rpx 0 22rpx;
  flex-wrap:wrap;
}
.swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border:3rpx solid #fff;
  box-shadow:var(--shadow-sm);
  display:flex;align-items:center;justify-content:center;
}
.swatch:active{transform:scale(.9);}
.swatch-check{color:#fff;font-size:30rpx;font-weight:900;text-shadow:0 1rpx 4rpx rgba(0,0,0,.3);}
.swatch.on {
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 8rpx #e86a7a;
  transform:scale(1.08);
}
.repeat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 20rpx;
  font-size: 28rpx;
  font-weight:700;
  background:#FFFAF7;
  border:2rpx solid var(--line);
  border-radius:20rpx;
  padding:14rpx 22rpx;
}
@keyframes slideUp{from{opacity:0;transform:translateY(20rpx);}to{opacity:1;transform:none;}}
@keyframes twinkle{0%,100%{opacity:.5;transform:scale(.9) rotate(-8deg);}50%{opacity:1;transform:scale(1.15) rotate(8deg);}}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10rpx);}}
