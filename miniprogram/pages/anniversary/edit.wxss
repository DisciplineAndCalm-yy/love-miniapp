.preview {
  color: #fff;
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 24rpx;
  min-height: 240rpx;
}

.preview-title {
  font-size: 44rpx;
  font-weight: 700;
  margin: 12rpx 0;
}

.preview-note {
  margin-top: 20rpx;
  opacity: 0.92;
  line-height: 1.6;
}

.field {
  background: #fff8f5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.area {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}

.colors {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.swatch.on {
  box-shadow: 0 0 0 6rpx #fff, 0 0 0 10rpx #e86a7a;
}
