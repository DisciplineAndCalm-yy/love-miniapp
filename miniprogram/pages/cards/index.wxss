.cards-page{position:relative;}
.cards-bg{position:fixed;left:0;right:0;top:0;bottom:0;pointer-events:none;z-index:0;overflow:hidden;}
.cards-page > .cards-hero, .cards-page > .mode-row, .cards-page > .stage, .cards-page > .card{position:relative;z-index:1;}
.float-heart{position:absolute;bottom:-60rpx;font-size:40rpx;opacity:0;animation:driftUp 13s linear infinite;}
.fh1{left:12%;animation-delay:0s;font-size:48rpx;}
.fh2{left:40%;animation-delay:4s;font-size:34rpx;animation-duration:15s;}
.fh3{left:66%;animation-delay:7s;font-size:44rpx;}
.fh4{left:88%;animation-delay:2s;font-size:34rpx;animation-duration:11s;}
@keyframes driftUp{0%{transform:translateY(0);opacity:0;}10%{opacity:.8;}85%{opacity:.5;}100%{transform:translateY(-110vh);opacity:0;}}
.cards-hero{display:flex;align-items:center;gap:18rpx;background:linear-gradient(135deg,#DCE9FB,#FFF6F1 60%,#FFE9EE);border-radius:36rpx;padding:24rpx 26rpx;margin-bottom:20rpx;border:2rpx solid #fff;outline:2rpx solid var(--line);outline-offset:-2rpx;box-shadow:var(--shadow);overflow:hidden;position:relative;}
.cards-art{width:110rpx;height:96rpx;flex-shrink:0;animation:float 3.4s ease-in-out infinite;}
.cards-title{font-size:36rpx;font-weight:800;}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10rpx);}}
.mode-row{display:flex;gap:16rpx;margin-bottom:22rpx;}
.mode{flex:1;display:flex;align-items:center;justify-content:center;gap:12rpx;background:#fff;border:2rpx solid var(--line);border-radius:28rpx;padding:22rpx 0;font-size:30rpx;font-weight:800;box-shadow:var(--shadow-sm);}
.mode:active{transform:scale(.96);}
.mode-icon{font-size:40rpx;}
.mode.truth-on{background:linear-gradient(135deg,#FF8A9C,#E14E68);color:#fff;border-color:#fff;}
.mode.dare-on{background:linear-gradient(135deg,#7AA3C9,#4A7FB5);color:#fff;border-color:#fff;}
.stage{background:linear-gradient(160deg,#FFF1F4,#EAF2FB);border-radius:40rpx;padding:44rpx 28rpx 30rpx;text-align:center;margin-bottom:22rpx;border:2rpx solid #fff;outline:2rpx solid var(--line);outline-offset:-2rpx;box-shadow:var(--shadow);position:relative;overflow:hidden;}
.poker{position:relative;width:380rpx;height:480rpx;margin:0 auto;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.3,1.3,.4,1);}
.poker.back{transform:rotateY(180deg);}
.poker.flipping{animation:shuffle .6s ease;}
@keyframes shuffle{0%{transform:rotateY(0) translateY(0);}25%{transform:rotateY(90deg) translateY(-20rpx);}50%{transform:rotateY(180deg) translateY(0);}75%{transform:rotateY(270deg) translateY(-20rpx);}100%{transform:rotateY(360deg) translateY(0);}}
.face{position:absolute;left:0;top:0;width:380rpx;height:480rpx;border-radius:36rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;backface-visibility:hidden;border:4rpx solid #fff;box-shadow:0 18rpx 40rpx rgba(209,78,100,.25);}
.front{background:linear-gradient(150deg,#FF9EB2,#E14E68 70%,#C9A0DC);}
.front-icon{font-size:110rpx;filter:drop-shadow(0 8rpx 10rpx rgba(0,0,0,.2));}
.front-text{font-size:32rpx;font-weight:900;color:#fff;text-shadow:0 2rpx 8rpx rgba(0,0,0,.2);}
.backside{background:linear-gradient(180deg,#fff,#FFF3F4);transform:rotateY(180deg);padding:36rpx 30rpx;box-sizing:border-box;}
.backside.dare-bg{background:linear-gradient(180deg,#fff,#EAF2FB);}
.back-kind{font-size:28rpx;font-weight:900;color:var(--rose-deep);background:var(--blush);border-radius:999rpx;padding:8rpx 28rpx;}
.dare-bg .back-kind{color:#4A7FB5;background:#DCE9FB;}
.back-text{font-size:32rpx;font-weight:800;line-height:1.6;}
.tip{margin-top:26rpx;}
.burst{position:absolute;top:20%;pointer-events:none;animation:burstUp 1.6s ease-out forwards;z-index:3;}
@keyframes burstUp{from{transform:translateY(0) scale(.5);opacity:1;}to{transform:translateY(-240rpx) scale(1.2);opacity:0;}}
.hi-item{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:2rpx dashed var(--line);animation:slideUp .3s ease;}
.hi-icon{width:64rpx;height:64rpx;border-radius:50%;font-size:34rpx;text-align:center;line-height:64rpx;background:#FFE9EE;flex-shrink:0;}
.hi-icon.dare{background:#DCE9FB;}
.hi-body{flex:1;min-width:0;}
.hi-text{font-size:28rpx;font-weight:700;line-height:1.5;}
@keyframes slideUp{from{opacity:0;transform:translateY(14rpx);}to{opacity:1;transform:none;}}
