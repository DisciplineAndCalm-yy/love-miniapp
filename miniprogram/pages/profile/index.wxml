<view class="page">
  <view class="card">
    <view class="title">我的名字</view>
    <input class="field" value="{{nickName}}" bindinput="onNick" placeholder="给自己起个昵称" />
    <button class="btn-ghost" bindtap="saveNick">保存昵称</button>
  </view>

  <view class="card">
    <view class="title">在一起的日子</view>
    <picker mode="date" value="{{togetherSince}}" bindchange="onTogether">
      <view class="field">{{togetherSince || '选择日期'}}</view>
    </picker>
    <button class="btn-ghost" bindtap="saveTogether" wx:if="{{inviteCode}}">保存日期</button>
  </view>

  <view class="card" wx:if="{{!inviteCode}}">
    <view class="title">绑定两个人</view>
    <view class="muted" style="margin: 12rpx 0 24rpx;">一个人生成邀请码，另一个人输入。</view>
    <button class="btn-primary" bindtap="create">生成邀请码</button>
    <input class="field" placeholder="输入对方邀请码" value="{{joinCode}}" bindinput="onJoinCode" />
    <button class="btn-ghost" bindtap="join">加入空间</button>
  </view>

  <view class="card" wx:else>
    <view class="title">情侣空间</view>
    <view class="code" bindtap="copyCode">{{inviteCode}}</view>
    <view class="muted">{{paired ? '已经两个人了' : '等待对方加入 · 点邀请码可复制'}}</view>
    <view class="muted" style="margin-top: 8rpx;">成员 {{memberCount}} / 2</view>
  </view>

  <view class="card" bindtap="goAnniversary">
    <view class="title">纪念日</view>
    <view class="muted">设计你们的重要日子和卡片文案</view>
  </view>

  <view class="card">
    <view class="title">纪念日提醒</view>
    <view class="muted" style="margin: 12rpx 0 24rpx;">
      {{remindEnabled ? '已授权。微信订阅消息是一次性的，想长期提醒就偶尔再点一次。' : '当天和前一天早上 9 点推送，需要微信订阅消息授权。'}}
    </view>
    <button class="btn-primary" bindtap="enableRemind">{{remindEnabled ? '再授权一次' : '开启提醒'}}</button>
  </view>
</view>
