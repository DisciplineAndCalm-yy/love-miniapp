.chat-page{height:100vh;display:flex;flex-direction:column;padding:0 26rpx 190rpx;box-sizing:border-box;background:linear-gradient(180deg,#FFE9EE 0%,#FFF6F1 40%,#FFF9EC 100%);position:relative;overflow:hidden;}
/* 温馨漂浮背景层 */
.chat-bg{position:absolute;left:0;right:0;top:0;bottom:0;pointer-events:none;z-index:0;overflow:hidden;}
.chat-bg image{position:absolute;left:0;right:0;top:0;width:100%;height:110rpx;opacity:.8;}
.float-heart{position:absolute;font-size:40rpx;opacity:0;animation:driftUp linear infinite;}
.fh1{left:8%;bottom:-60rpx;animation-duration:11s;}
.fh2{left:24%;bottom:-80rpx;font-size:30rpx;animation-duration:14s;animation-delay:-4s;}
.fh3{left:48%;bottom:-60rpx;font-size:52rpx;animation-duration:10s;animation-delay:-2s;}
.fh4{left:66%;bottom:-90rpx;font-size:28rpx;animation-duration:15s;animation-delay:-7s;}
.fh5{left:82%;bottom:-70rpx;font-size:44rpx;animation-duration:12s;animation-delay:-5s;}
.fh6{left:38%;bottom:-100rpx;font-size:26rpx;animation-duration:16s;animation-delay:-9s;}
@keyframes driftUp{
  0%{transform:translateY(0) rotate(-8deg);opacity:0;}
  12%{opacity:.55;}
  85%{opacity:.4;}
  100%{transform:translateY(-110vh) rotate(10deg);opacity:0;}
}
.chat-head{flex-shrink:0;position:relative;z-index:1;padding-top:18rpx;}
.chat-tip{font-size:22rpx;color:#C08B90;background:rgba(255,255,255,.92);border:2rpx solid var(--line);border-radius:999rpx;padding:12rpx 22rpx;margin-bottom:14rpx;box-shadow:var(--shadow-sm);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center;}
.quick-scroll{white-space:nowrap;margin-bottom:14rpx;}
.quick{display:inline-block;background:linear-gradient(180deg,#fff,#FFF3F4);border:2rpx solid var(--line);border-radius:999rpx;padding:13rpx 28rpx;font-size:25rpx;font-weight:700;color:var(--rose-deep);margin-right:14rpx;box-shadow:var(--shadow-sm);}
.quick:active{transform:scale(.94);}
.msg-scroll{flex:1;min-height:0;position:relative;z-index:1;}
.msg-row{display:flex;gap:14rpx;align-items:flex-end;max-width:100%;animation:pop .25s ease;margin-bottom:22rpx;}
.msg-row.mine{flex-direction:row-reverse;}
.msg-avatar{width:76rpx;height:76rpx;border-radius:28rpx;flex-shrink:0;border:3rpx solid #fff;box-shadow:var(--shadow-sm);background:#FFE9EE;}
.msg-body{max-width:70%;display:flex;flex-direction:column;min-width:0;}
.mine .msg-body{align-items:flex-end;}
.msg-meta{font-size:21rpx;color:#C49AA0;margin-bottom:8rpx;padding:0 6rpx;}
.bubble{font-size:29rpx;line-height:1.65;padding:20rpx 28rpx;border-radius:30rpx;word-break:break-all;}
.ta .bubble{background:#fff;border:2rpx solid #F6E2E3;border-top-left-radius:10rpx;color:var(--ink);box-shadow:var(--shadow-sm);}
.mine .bubble{background:linear-gradient(135deg,#FF8A9C,#EF5E7C);color:#fff;border-top-right-radius:10rpx;box-shadow:0 12rpx 26rpx rgba(239,94,124,.35);}
.bubble-img{width:330rpx;max-width:100%;border-radius:26rpx;border:3rpx solid #fff;box-shadow:var(--shadow);}
.bottom-anchor{height:10rpx;}
.composer{position:fixed;left:0;right:0;bottom:0;background:rgba(255,255,255,.97);border-top:2rpx solid var(--line);padding:14rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));box-shadow:0 -12rpx 30rpx rgba(209,78,100,.08);z-index:70;}
.composer-row{display:flex;align-items:center;gap:8rpx;}
.icon-btn{display:inline-flex;align-items:center;justify-content:center;font-size:30rpx;width:48rpx;height:48rpx;flex-shrink:0;background:#FFF3F4;border:2rpx solid var(--line);border-radius:50%;line-height:1;}
.icon-btn:active{transform:scale(.9);}
.chat-input{flex:1;min-width:0;background:#FFFAF7;border:2rpx solid var(--line);border-radius:999rpx;padding:10rpx 18rpx;font-size:25rpx;min-height:36rpx;box-shadow:inset 0 2rpx 8rpx rgba(209,78,100,.06);}
.chat-input:focus{border-color:#F6A9B4;}
button.send-btn{font-size:26rpx;padding:0;line-height:2.4;flex-shrink:0;width:150rpx;text-align:center;margin:0;}
button.send-btn::after{border:none;}
.send-btn[disabled]{opacity:.6;}
.emoji-panel{display:flex;flex-wrap:wrap;gap:6rpx;padding:12rpx 4rpx 18rpx;background:#FFF8F4;border:2rpx solid var(--line);border-radius:26rpx;margin-bottom:14rpx;}
.emoji{font-size:48rpx;width:90rpx;text-align:center;border-radius:18rpx;}
.emoji:active{background:#FFE9EE;}
.read-mark{position:fixed;right:30rpx;bottom:calc(196rpx + env(safe-area-inset-bottom));font-size:22rpx;color:#fff;background:linear-gradient(135deg,#9BDFB2,#6ABF69);padding:8rpx 20rpx;border-radius:999rpx;box-shadow:var(--shadow-sm);z-index:65;}
@keyframes pop{from{opacity:0;transform:translateY(12rpx) scale(.98);}to{opacity:1;transform:none;}}
