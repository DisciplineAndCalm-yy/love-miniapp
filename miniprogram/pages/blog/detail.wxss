.blog-detail{padding-bottom:60rpx;}
.detail-card{position:relative;overflow:hidden;animation:slideUp .35s ease;}
.detail-stamp{position:absolute;right:16rpx;top:12rpx;font-size:88rpx;opacity:.16;transform:rotate(10deg);pointer-events:none;}
.detail-title{font-size:42rpx;margin:18rpx 0 10rpx;line-height:1.4;}
.author-chip{display:inline-block;font-size:24rpx;font-weight:700;color:var(--rose-deep);background:linear-gradient(180deg,#FFF6F7,var(--blush));border:2rpx solid #F6BCC5;border-radius:999rpx;padding:8rpx 24rpx;margin-bottom:24rpx;box-shadow:var(--shadow-sm);}
.detail-place{font-size:25rpx;color:#B79A9E;font-weight:700;margin:0 0 16rpx;}
.body {
  white-space: pre-wrap;
  line-height: 1.9;
  font-size: 30rpx;
  color: #3d2c2e;
  letter-spacing:.02em;
}
.body::first-letter{font-size:44rpx;font-weight:800;color:var(--rose-deep);}
.meta {
  margin: 12rpx 0 28rpx;
}
.photo {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 20rpx;
  border: 3rpx solid #fff;
  box-shadow: var(--shadow);
}
.detail-foot{text-align:center;font-size:25rpx;color:var(--muted);margin-top:36rpx;letter-spacing:.1em;}
.actions {
  display: flex;
  gap: 16rpx;
}
.actions button {
  flex: 1;
}
.act-btn{font-size:26rpx;}
@keyframes slideUp{from{opacity:0;transform:translateY(20rpx);}to{opacity:1;transform:none;}}

/* 互动区 */
.interact-card{margin-top:22rpx;}
.interact-bar{display:flex;gap:16rpx;padding-bottom:8rpx;border-bottom:2rpx dashed #F7D8DB;}
.i-btn{display:inline-flex;align-items:center;gap:8rpx;padding:12rpx 24rpx;border-radius:999rpx;background:#FFF3F4;border:2rpx solid #F7D8DB;font-size:27rpx;color:#C08B90;}
.i-btn.on{background:linear-gradient(135deg,#FFE1E7,#FFD0DA);border-color:#F6A9B4;color:#D14E64;}
.i-btn:active{transform:scale(.95);}
.i-icon{font-size:32rpx;line-height:1;}
.i-txt{font-weight:700;}
.cmt-list{margin-top:18rpx;}
.cmt{padding:14rpx 0;border-bottom:2rpx solid #FBEFF0;}
.cmt:last-child{border-bottom:none;}
.cmt-head{display:flex;align-items:center;gap:12rpx;}
.cmt-name{font-size:26rpx;font-weight:700;color:var(--rose-deep);}
.cmt-time{font-size:22rpx;color:#C49AA0;}
.cmt-del{margin-left:auto;font-size:23rpx;color:#C08B90;}
.cmt-text{font-size:28rpx;line-height:1.6;color:var(--ink);margin-top:6rpx;word-break:break-all;}
.cmt-empty{padding:22rpx 0;text-align:center;}
.cmt-input-row{display:flex;align-items:center;gap:12rpx;margin-top:18rpx;}
.cmt-input{flex:1;min-width:0;background:#FFFAF7;border:2rpx solid #F7D8DB;border-radius:999rpx;padding:14rpx 24rpx;font-size:27rpx;}
button.cmt-send{flex-shrink:0;width:140rpx;padding:0;line-height:2.2;margin:0;font-size:26rpx;}
button.cmt-send::after{border:none;}
.reaction-bar{display:flex;gap:10rpx;margin-top:14rpx;}
.reaction-btn{width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#FFF3F4;border:2rpx solid #F7D8DB;font-size:34rpx;}
.reaction-btn:active{transform:scale(.9);}
.reaction-summary{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx;}
.rs-chip{font-size:24rpx;font-weight:700;color:#C08B90;background:#FFF3F4;border:2rpx solid #F7D8DB;border-radius:999rpx;padding:6rpx 18rpx;}
.rs-chip.on{background:linear-gradient(135deg,#FFE1E7,#FFD0DA);border-color:#F6A9B4;color:#D14E64;}
.cmt-reply{font-size:22rpx;color:#9A7F82;}
.reply-bar{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;padding:10rpx 18rpx;background:#FFF3F4;border-radius:16rpx;border:2rpx dashed #F6BCC5;}
.reply-txt{font-size:24rpx;font-weight:700;color:#D14E64;}
.reply-cancel{font-size:23rpx;color:#C08B90;}
.at-btn{flex-shrink:0;font-size:24rpx;font-weight:800;color:#D14E64;background:#FFF3F4;border:2rpx solid #F7D8DB;border-radius:999rpx;padding:10rpx 18rpx;}

