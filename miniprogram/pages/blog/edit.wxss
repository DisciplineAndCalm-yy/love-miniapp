.title-input {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.body {
  width: 100%;
  min-height: 360rpx;
  background: #fff8f5;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 32rpx;
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.thumb.add {
  background: #fff8f5;
  color: #e86a7a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
