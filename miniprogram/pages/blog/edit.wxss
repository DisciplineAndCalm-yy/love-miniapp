.title-input {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.body {
  width: 100%;
  min-height: 360rpx;
  background: #fff8f5;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 12rpx;
}

.thumb-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.thumb-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(61, 44, 46, 0.72);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.thumb.add {
  background: #fff8f5;
  color: #e86a7a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(232, 106, 122, 0.35);
}
