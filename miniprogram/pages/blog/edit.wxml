<view class="page">
  <view class="card">
    <input class="title-input" placeholder="标题" value="{{title}}" bindinput="onTitle" maxlength="40" />
    <textarea class="body" placeholder="写给对方看的内容" value="{{content}}" bindinput="onContent" maxlength="5000" />
    <view class="photos">
      <view class="thumb-wrap" wx:for="{{photos}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" class="thumb" />
        <view class="thumb-del" data-index="{{index}}" bindtap="removePhoto">×</view>
      </view>
      <view class="thumb add" wx:if="{{photos.length < 9}}" bindtap="addPhoto">+</view>
    </view>
    <view class="muted" style="margin-bottom: 24rpx;">最多 9 张图 · 点 × 可移除</view>
    <button class="btn-primary" loading="{{saving}}" bindtap="save">{{id ? '保存修改' : '发布到空间'}}</button>
  </view>
</view>
