.blog-page{padding-bottom:60rpx;}
.blog-hero{display:flex;gap:20rpx;align-items:center;overflow:hidden;}
.blog-art{width:150rpx;height:126rpx;flex-shrink:0;animation:float 3.4s ease-in-out infinite;}
.blog-write{font-size:26rpx;padding:0 40rpx;}
.blog-sticker{position:absolute;right:20rpx;bottom:16rpx;font-size:52rpx;opacity:.9;animation:float 2.8s ease-in-out infinite;pointer-events:none;}
.empty-art{width:220rpx;height:176rpx;margin:0 auto 10rpx;}
.empty-card{text-align:center;}
.post {
  padding-bottom: 28rpx;
  position: relative;
  overflow: hidden;
  animation: slideUp .35s ease;
}
.post:active {
  opacity: 0.92;
  transform: scale(.99);
}
.post-stamp{position:absolute;right:18rpx;top:14rpx;font-size:56rpx;opacity:.28;transform:rotate(10deg);pointer-events:none;}
.post-head .title {
  margin-bottom: 8rpx;
  padding-right: 80rpx;
}
.post-meta{background:#FFF6F1;display:inline-block;padding:4rpx 16rpx;border-radius:999rpx;margin-top:6rpx;}
.excerpt {
  margin-top: 16rpx;
  color: #5c4548;
  font-size: 28rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.post-place { font-size: 24rpx; color: #B79A9E; font-weight: 700; margin-top: 8rpx; }
.thumb-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.mini-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx solid #fff;
  box-shadow: var(--shadow-sm);
}
.read-more{margin-top:18rpx;font-size:25rpx;font-weight:800;color:var(--rose-deep);}
.read-more::after{content:"";display:block;height:2rpx;background:linear-gradient(90deg,var(--line),transparent);margin-top:6rpx;}
@keyframes slideUp{from{opacity:0;transform:translateY(20rpx);}to{opacity:1;transform:none;}}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10rpx);}}

/* 未读互动提示条 */
.unread-banner{display:flex;align-items:center;gap:12rpx;background:linear-gradient(135deg,#FFE9EE,#FFF3F4);border:2rpx solid #F6BCC5;border-radius:24rpx;padding:18rpx 22rpx;margin-bottom:20rpx;box-shadow:var(--shadow-sm);}
.ub-dot{width:16rpx;height:16rpx;border-radius:50%;background:#FF5A78;flex-shrink:0;box-shadow:0 0 0 4rpx rgba(255,90,120,.18);}
.ub-text{flex:1;font-size:25rpx;font-weight:700;color:#C9405A;line-height:1.5;}
.ub-go{flex-shrink:0;font-size:24rpx;font-weight:800;color:var(--rose-deep);}
/* 文章卡片互动计数 */
.post-foot{display:flex;align-items:center;gap:16rpx;margin-top:18rpx;}
.pf-item{font-size:24rpx;font-weight:700;color:#C08B90;background:#FFF6F1;border-radius:999rpx;padding:4rpx 16rpx;}
.pf-new{margin-left:auto;font-size:22rpx;font-weight:800;color:#D14E64;}

