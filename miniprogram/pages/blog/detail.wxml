<view class="page" wx:if="{{post}}">
  <view class="card">
    <view class="title">{{post.title}}</view>
    <view class="muted" style="margin: 12rpx 0 28rpx;">{{post.createdAt}}</view>
    <text class="body">{{post.content}}</text>
    <image wx:for="{{post.photos}}" wx:key="*this" src="{{item}}" mode="widthFix" class="photo" />
  </view>
  <view class="actions" wx:if="{{mine}}">
    <button class="btn-ghost" bindtap="edit">编辑</button>
    <button class="btn-ghost" bindtap="remove">删除</button>
  </view>
</view>
