.streaks {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.streak {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(232, 106, 122, 0.08);
}

.streak .num {
  font-size: 48rpx;
  font-weight: 700;
  color: #c94b5c;
}

.moods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 0;
}

.mood {
  padding: 12rpx 24rpx;
  background: #fff1ec;
  border-radius: 999rpx;
  color: #9a7f82;
}

.mood.on {
  background: #e86a7a;
  color: #fff;
}

.area {
  width: 100%;
  min-height: 160rpx;
  background: #fff8f5;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.photo-wrap {
  margin-bottom: 28rpx;
}

.photo {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
}

.photo-add {
  height: 160rpx;
  border-radius: 20rpx;
  background: #fff8f5;
  color: #9a7f82;
  display: flex;
  align-items: center;
  justify-content: center;
}
