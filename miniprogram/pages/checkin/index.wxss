.streaks {
  display: flex;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.streak {
  flex: 1;
  background: linear-gradient(180deg, #FFF6F1, #FFEEE9);
  border-radius: 28rpx;
  padding: 26rpx 12rpx;
  text-align: center;
  border: 3rpx solid #fff;
  box-shadow: 0 12rpx 30rpx rgba(209, 78, 100, 0.1);
}

.streak .num {
  font-size: 52rpx;
  font-weight: 900;
  color: #D14E64;
  line-height: 1.1;
}

.moods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 0;
}

.mood {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 14rpx 26rpx;
  background: linear-gradient(180deg,#fff,#FFF3F4);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  color: #9a7f82;
  font-weight: 700;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}
.mood-icon { font-size: 34rpx; line-height: 1; }
.mood-label { font-size: 26rpx; }
.mood:active { transform: scale(.93); }
.mood.on {
  background: linear-gradient(135deg,#FF8A9C,#E14E68);
  color: #fff;
  border-color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(232, 106, 122, 0.35);
}
.checkin-quicks { white-space: nowrap; margin: 0 0 20rpx; }
.checkin-quick {
  display: inline-block; font-size: 24rpx; font-weight: 700; color: var(--rose-deep);
  background: #FFF6F7; border: 2rpx dashed #F5B3BE; border-radius: 999rpx;
  padding: 10rpx 24rpx; margin-right: 12rpx;
}
.checkin-quick:active { transform: scale(.94); }

.area {
  width: 100%;
  min-height: 160rpx;
  background: #fff8f5;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.photo-wrap {
  margin-bottom: 28rpx;
}

.photo {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
}

.photo-add {
  height: 160rpx;
  border-radius: 20rpx;
  background: #fff8f5;
  color: #9a7f82;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-clear {
  margin-top: 12rpx;
  color: #c94b5c;
  font-size: 24rpx;
  text-align: right;
}

.partner-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mini-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #FF9EB2, #F06A80);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 6rpx 14rpx rgba(209, 78, 100, 0.2);
  flex-shrink: 0;
}
.mini-avatar image {
  width: 100%;
  height: 100%;
}

.partner-line {
  margin: 16rpx 0 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.empty-bind {
  padding: 80rpx 24rpx;
  text-align: center;
}

.done-card {
  text-align: center;
}

.done-badge {
  display: inline-block;
  background: linear-gradient(135deg, #B8E6A0, #6ABF69);
  color: #fff;
  font-weight: 800;
  font-size: 30rpx;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 10rpx 24rpx rgba(106, 191, 105, 0.3);
}

.done-mood {
  font-size: 34rpx;
  font-weight: 700;
  color: #D14E64;
  margin-top: 8rpx;
}

.done-content {
  font-size: 30rpx;
  line-height: 1.7;
  margin: 16rpx 0;
  color: #4A3236;
}
