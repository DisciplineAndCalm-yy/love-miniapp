.streaks {
  display: flex;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.streak {
  flex: 1;
  background: linear-gradient(180deg, #FFF6F1, #FFEEE9);
  border-radius: 28rpx;
  padding: 26rpx 12rpx;
  text-align: center;
  border: 3rpx solid #fff;
  box-shadow: 0 12rpx 30rpx rgba(209, 78, 100, 0.1);
}

.streak .num {
  font-size: 52rpx;
  font-weight: 900;
  color: #D14E64;
  line-height: 1.1;
}

.moods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 0;
}

.mood {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 14rpx 26rpx;
  background: linear-gradient(180deg,#fff,#FFF3F4);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  color: #9a7f82;
  font-weight: 700;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}
.mood-icon { font-size: 34rpx; line-height: 1; }
.mood-label { font-size: 26rpx; }
.mood:active { transform: scale(.93); }
.mood.on {
  background: linear-gradient(135deg,#FF8A9C,#E14E68);
  color: #fff;
  border-color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(232, 106, 122, 0.35);
}
.checkin-quicks { white-space: nowrap; margin: 0 0 20rpx; }
.checkin-quick {
  display: inline-block; font-size: 24rpx; font-weight: 700; color: var(--rose-deep);
  background: #FFF6F7; border: 2rpx dashed #F5B3BE; border-radius: 999rpx;
  padding: 10rpx 24rpx; margin-right: 12rpx;
}
.checkin-quick:active { transform: scale(.94); }

.area {
  width: 100%;
  min-height: 160rpx;
  background: #fff8f5;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.photo-wrap {
  margin-bottom: 28rpx;
}

.photo {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
}

.photo-add {
  height: 160rpx;
  border-radius: 20rpx;
  background: #fff8f5;
  color: #9a7f82;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-clear {
  margin-top: 12rpx;
  color: #c94b5c;
  font-size: 24rpx;
  text-align: right;
}

.partner-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mini-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #FF9EB2, #F06A80);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 6rpx 14rpx rgba(209, 78, 100, 0.2);
  flex-shrink: 0;
}
.mini-avatar image {
  width: 100%;
  height: 100%;
}

.partner-line {
  margin: 16rpx 0 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.empty-bind {
  padding: 80rpx 24rpx;
  text-align: center;
}

.done-card {
  text-align: center;
}

.done-badge {
  display: inline-block;
  background: linear-gradient(135deg, #B8E6A0, #6ABF69);
  color: #fff;
  font-weight: 800;
  font-size: 30rpx;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 10rpx 24rpx rgba(106, 191, 105, 0.3);
}

.done-mood {
  font-size: 34rpx;
  font-weight: 700;
  color: #D14E64;
  margin-top: 8rpx;
}

.done-content {
  font-size: 30rpx;
  line-height: 1.7;
  margin: 16rpx 0;
  color: #4A3236;
}

/* 今日天气 + 夸夸融合卡 */
.wx-banner {
  position: relative; overflow: hidden; margin-bottom: 26rpx;
  border-radius: 40rpx; padding: 30rpx 30rpx 26rpx;
  border: 3rpx solid #fff; box-shadow: var(--shadow);
  background: linear-gradient(135deg, #FFE9EE 0%, #FFF6F1 60%, #FFF0C4 100%);
}
.wx-banner.cond-sunny { background: linear-gradient(135deg,#FFF4D9 0%,#FFE9C2 55%,#FFD9A0 100%); }
.wx-banner.cond-cloudy { background: linear-gradient(135deg,#EEF2F8 0%,#FFF6F1 60%,#E7EEF9 100%); }
.wx-banner.cond-rain { background: linear-gradient(135deg,#E2EFF9 0%,#EEF4FB 55%,#DCE9FB 100%); }
.wx-banner.cond-thunder { background: linear-gradient(135deg,#E4E3F3 0%,#EFEDFA 60%,#DCD8F0 100%); }
.wx-banner.cond-snow { background: linear-gradient(135deg,#EAF4FF 0%,#F7FBFF 60%,#E3F0FA 100%); }
.wx-banner.cond-fog { background: linear-gradient(135deg,#EEEDEA 0%,#F7F5F1 60%,#E6E4DE 100%); }
.wx-deco {
  position: absolute; right: -20rpx; bottom: -30rpx; font-size: 190rpx; opacity: .18;
  transform: rotate(-8deg); pointer-events: none;
}
.wx-banner-top { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 2; }
.wx-left { display: flex; align-items: center; gap: 20rpx; }
.wx-big-emoji { font-size: 86rpx; filter: drop-shadow(0 8rpx 14rpx rgba(80,110,150,.25)); animation: float 3.4s ease-in-out infinite; }
.wx-city { font-size: 25rpx; font-weight: 800; color: #5A6A88; }
.wx-temp { font-size: 46rpx; font-weight: 900; color: #3A5A8C; margin-top: 2rpx; }
.wx-txt { font-size: 26rpx; font-weight: 800; color: #463035; margin-left: 12rpx; }
.wx-go {
  flex-shrink: 0; font-size: 23rpx; font-weight: 800; color: var(--rose-deep);
  background: rgba(255,255,255,.85); border: 2rpx solid var(--line);
  border-radius: 999rpx; padding: 10rpx 22rpx; box-shadow: var(--shadow-sm);
}
.wx-go:active { transform: scale(.95); }
.wx-praise {
  position: relative; z-index: 2; margin-top: 22rpx;
  background: rgba(255,255,255,.82); border-radius: 26rpx; padding: 20rpx 22rpx;
  display: flex; align-items: center; gap: 16rpx; border: 2rpx solid #fff;
}
.praise-text { flex: 1; font-size: 27rpx; font-weight: 700; line-height: 1.6; color: #C9405A; }
.praise-use {
  flex-shrink: 0; font-size: 23rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg,#FF8A9C,#E14E68); border-radius: 999rpx; padding: 10rpx 22rpx;
  box-shadow: 0 8rpx 18rpx rgba(232,106,122,.35);
}
.praise-use:active { transform: scale(.94); }

/* 撒花 */
.burst-layer { position: fixed; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; z-index: 90; overflow: hidden; }
.burst-p { position: absolute; top: 34%; animation-name: burstUp; animation-timing-function: ease-out; animation-fill-mode: forwards; }
@keyframes burstUp { from { transform: translateY(0) scale(.5) rotate(0); opacity: 1; } to { transform: translateY(420rpx) scale(1.2) rotate(40deg); opacity: 0; } }

