<view class="page">
  <view class="empty-bind" wx:if="{{!paired}}">
    <view class="title">打卡需要两个人的空间</view>
    <view class="muted" style="margin: 16rpx 0 32rpx;">先绑定情侣，再把今天的心情留给对方。</view>
    <button class="btn-primary" bindtap="goBind">去绑定</button>
  </view>

  <block wx:else>
    <view class="streaks">
      <view class="streak">
        <view class="num">{{streaks.mine}}</view>
        <view class="muted">我的连续</view>
      </view>
      <view class="streak">
        <view class="num">{{streaks.partner}}</view>
        <view class="muted">TA 的连续</view>
      </view>
      <view class="streak">
        <view class="num">{{streaks.together}}</view>
        <view class="muted">同一天</view>
      </view>
    </view>

    <view class="card" wx:if="{{!mine}}">
      <view class="title">每日签到 · 每天一次</view>
      <view class="muted" style="margin: 8rpx 0 20rpx;">今天的心情，只能盖一次章哦 ♡</view>
      <view class="moods">
        <view
          class="mood {{mood === item.id ? 'on' : ''}}"
          wx:for="{{moods}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onMood"
        ><text class="mood-icon">{{item.icon}}</text><text class="mood-label">{{item.label}}</text></view>
      </view>
      <scroll-view scroll-x class="checkin-quicks">
        <text class="checkin-quick" wx:for="{{quicks}}" wx:key="*this" data-text="{{item}}" bindtap="fillQuick">{{item}}</text>
      </scroll-view>
      <textarea class="area" maxlength="120" placeholder="想和对方说的一句…" value="{{content}}" bindinput="onContent" />
      <view class="photo-wrap">
        <block wx:if="{{photo}}">
          <image src="{{photoUrl || photo}}" mode="aspectFill" class="photo" bindtap="previewPhoto" data-url="{{photoUrl || photo}}" binderror="photoError" />
          <view class="photo-clear" bindtap="clearPhoto">移除图片</view>
        </block>
        <view wx:else class="photo-add" bindtap="onPickPhoto">📷 添加一张图（可选）</view>
      </view>
      <button class="btn-primary" loading="{{saving}}" bindtap="onSubmit">完成签到 ♡</button>
      <button class="btn-ghost" bindtap="goMoments" style="margin-top:20rpx">去记录日常动态 →</button>
    </view>

    <view class="card done-card" wx:else>
      <view class="done-badge">✓ 今天已签到</view>
      <view class="muted" style="margin: 8rpx 0 20rpx;">明天记得再来盖一次章哦 ♡</view>
      <view class="done-mood">{{mine.mood ? moodMap[mine.mood] : ''}}</view>
      <view class="done-content" wx:if="{{mine.content}}">{{mine.content}}</view>
      <image wx:if="{{mine.photo}}" src="{{mine.photo}}" mode="aspectFill" class="photo" data-url="{{mine.photo}}" bindtap="previewPhoto" />
      <button class="btn-ghost" bindtap="goCalendar" style="margin-top:24rpx">去日历看两人签到 →</button>
      <button class="btn-ghost" bindtap="goMoments" style="margin-top:16rpx">去记录日常动态 →</button>
    </view>

    <view class="card" wx:if="{{partner}}">
      <view class="partner-head">
        <view class="mini-avatar">
          <image wx:if="{{partnerAvatarUrl}}" src="{{partnerAvatarUrl}}" mode="aspectFill" binderror="partnerAvatarError" />
          <text wx:else>{{partnerInitial}}</text>
        </view>
        <view class="title">{{partnerName}} 今天</view>
      </view>
      <view class="partner-line">{{partnerMoodLabel}} · {{partner.content || '打卡了'}}</view>
      <image wx:if="{{partnerPhotoUrl || partner.photo}}" src="{{partnerPhotoUrl || partner.photo}}" mode="aspectFill" class="photo" data-url="{{partnerPhotoUrl || partner.photo}}" bindtap="previewPhoto" binderror="partnerPhotoError" />
    </view>
  </block>
</view>
