page {
  --bg: #FFF7F3;
  --card: #FFFFFF;
  --ink: #463035;
  --muted: #B39496;
  --rose: #F0627E;
  --rose-deep: #D14E64;
  --blush: #FFECEF;
  --cream: #FFF4D9;
  --mint: #DCF3E3;
  --sky: #DCE9FB;
  --line: #F7D8DB;
  --shadow: 0 16rpx 44rpx rgba(209, 78, 100, 0.12);
  --shadow-sm: 0 8rpx 22rpx rgba(209, 78, 100, 0.10);
  --r-lg: 40rpx;
  --r-md: 28rpx;
  background-color: var(--bg);
  background-image:
    radial-gradient(circle at 8% 0%, #FFD6DE 0 110rpx, transparent 111rpx),
    radial-gradient(circle at 95% 6%, #FFEEC2 0 90rpx, transparent 91rpx),
    radial-gradient(circle at 100% 55%, #D8EFDF 0 80rpx, transparent 81rpx),
    radial-gradient(rgba(240,98,126,.09) 2.5rpx, transparent 2.6rpx);
  background-size: auto, auto, auto, 46rpx 46rpx;
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  box-sizing: border-box;
}
.page { padding: 28rpx 30rpx calc(70rpx + env(safe-area-inset-bottom)); min-height: 100vh; }
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 28rpx;
  border: 2rpx solid #fff;
  outline: 2rpx solid var(--line);
  outline-offset: -2rpx;
  position: relative;
  overflow: hidden;
}
.card::before {
  content: ""; position: absolute; left: 0; right: 0; top: 0; height: 10rpx;
  background: linear-gradient(90deg, #FF9EB2, #FFC978 30%, #9BDFB2 55%, #93C4F2 80%, #FF9EB2);
  opacity: .5;
  pointer-events: none;
}
/* 注:不要给 .card 加 :active 位移,祖先 transform 会打断原生 textarea 聚焦 */
/* 表单与按钮提到装饰层之上,保证真机可点可聚焦(WXSS 不支持通配符,逐个列出) */
.card textarea, .card input, .card button, .card .field, .card .area,
.card .mood, .card .tag, .card .photo-add, .card .add, .card .thumb,
.card .photo, .card .photo-clear, .card .checkin-quick,
.hero .link, .hero button { position: relative; z-index: 5; }
.muted { color: var(--muted); font-size: 25rpx; line-height: 1.7; }
.title { font-size: 37rpx; font-weight: 800; letter-spacing: .02em; }
.title::after { content: " ♡"; color: var(--rose); font-size: 28rpx; }
.btn-primary {
  background: linear-gradient(135deg, #FF8A9C 0%, #F0627E 55%, #DD4A67 100%);
  color: #fff; border-radius: 999rpx; font-size: 28rpx; font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(240,98,126,.32), inset 0 2rpx 0 rgba(255,255,255,.55);
  border: 2rpx solid rgba(255,255,255,.9);
  transition: transform .15s ease, box-shadow .15s ease;
}
.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(.96); box-shadow: 0 8rpx 18rpx rgba(240,98,126,.3); }
button.btn-primary, button.btn-ghost, button.btn-danger { line-height: 2.3; padding: 0 28rpx; }
.btn-ghost {
  background: linear-gradient(180deg, #FFF6F7, var(--blush));
  color: var(--rose-deep); border-radius: 999rpx; font-size: 27rpx;
  border: 2rpx solid #F6BCC5; font-weight: 700;
  box-shadow: var(--shadow-sm);
}
.btn-ghost::after { border: none; }
.btn-ghost:active { transform: scale(.97); }
.btn-danger { background: transparent; color: var(--rose-deep); border-radius: 999rpx; font-size: 28rpx; }
.btn-danger::after { border: none; }
.hero {
  background: linear-gradient(155deg, #FFDCE3 0%, #FFF3EE 48%, #FFF0C4 100%);
  border-radius: 48rpx; padding: 40rpx 36rpx 36rpx; margin-bottom: 28rpx;
  position: relative; overflow: hidden;
  border: 2rpx solid #fff; outline: 2rpx solid var(--line); outline-offset: -2rpx;
  box-shadow: var(--shadow);
}
.hero::before {
  content: "♥ ♥ ♥"; position: absolute; right: 26rpx; top: 20rpx;
  color: rgba(209,78,100,.16); font-size: 34rpx; letter-spacing: 8rpx;
  pointer-events: none;
}
.hero::after {
  content: ""; position: absolute; right: -64rpx; bottom: -74rpx; width: 240rpx; height: 240rpx;
  border-radius: 50%; background: rgba(255,255,255,.55);
  box-shadow: -22rpx -22rpx 0 rgba(255,255,255,.42);
  pointer-events: none;
}
.pill {
  display: inline-flex; align-items: center; padding: 10rpx 26rpx;
  background: rgba(255,255,255,.92); border: 2rpx solid var(--line); border-radius: 999rpx;
  font-size: 23rpx; font-weight: 800; color: var(--rose-deep); letter-spacing: .04em;
  box-shadow: 0 8rpx 16rpx rgba(209,78,100,.14);
}
.empty { text-align: center; padding: 90rpx 24rpx; color: var(--muted); font-size: 27rpx; line-height: 2; }
.empty::before { content: "♡"; display: block; font-size: 64rpx; color: #F5B3BE; margin-bottom: 12rpx; }
.avatar { width: 108rpx; height: 108rpx; border-radius: 36rpx; background: var(--blush); overflow: hidden; border: 3rpx solid #fff; box-shadow: var(--shadow-sm); }
.avatar image { width: 100%; height: 100%; }
.avatar-fallback {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 40rpx; font-weight: 800;
  background: linear-gradient(135deg, #FF9EB2, #F0627E);
}
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
button { line-height: 1.4; }
button::after { border: none; }
.sticker { position: absolute; font-size: 46rpx; opacity: .9; filter: drop-shadow(0 4rpx 6rpx rgba(209,78,100,.22)); animation: float 3s ease-in-out infinite; }
.field, .area, input.field, textarea.area {
  background: #FFFAF7 !important; border: 2rpx solid var(--line) !important;
  border-radius: 26rpx !important; box-shadow: inset 0 2rpx 8rpx rgba(209,78,100,.06) !important;
}
.field:focus, .area:focus { border-color: #F6A9B4 !important; box-shadow: 0 0 0 6rpx rgba(240,98,126,.12) !important; }
.tag { border: 2rpx solid var(--line); background: #fff; box-shadow: var(--shadow-sm); }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
