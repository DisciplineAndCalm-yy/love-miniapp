page {
  background: #fff8f5;
  color: #3d2c2e;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", sans-serif;
  box-sizing: border-box;
}

.page {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(232, 106, 122, 0.08);
  margin-bottom: 24rpx;
}

.muted {
  color: #9a7f82;
  font-size: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.btn-primary {
  background: #e86a7a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #fff1ec;
  color: #c94b5c;
  border-radius: 999rpx;
}

.btn-ghost::after {
  border: none;
}

.hero {
  background: linear-gradient(135deg, #ffd6dc 0%, #fff1ec 55%, #ffe8d2 100%);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #c94b5c;
}

.empty {
  text-align: center;
  padding: 80rpx 24rpx;
  color: #9a7f82;
}
