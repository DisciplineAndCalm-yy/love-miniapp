<view class="page dg-page">
  <view class="dg-score">
    <view class="dg-score-item">
      <text class="dg-num">{{myScore}}</text>
      <text class="dg-lbl">我</text>
    </view>
    <view class="dg-vs">VS</view>
    <view class="dg-score-item">
      <text class="dg-num">{{partnerScore}}</text>
      <text class="dg-lbl">{{partnerName}}</text>
    </view>
  </view>

  <view class="dg-stage">
    <canvas type="2d" id="dgCanvas" class="dg-canvas"
      bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd"></canvas>
    <view wx:if="{{role === 'none'}}" class="dg-mask">选个词，开始画给 TA 猜 👇</view>
    <view wx:if="{{role === 'drawer'}}" class="dg-badge">你要画：<text class="dg-badge-word">{{answer}}</text></view>
    <view wx:if="{{role === 'guesser'}}" class="dg-badge guest">TA 正在画，你来猜 ♡</view>
  </view>

  <block wx:if="{{role === 'none'}}">
    <view class="dg-hint">点一个词，你就成为画手，TA 来猜</view>
    <view class="dg-words">
      <view class="dg-word-chip" wx:for="{{words}}" wx:key="*this" data-w="{{item}}" bindtap="chooseWord">{{item}}</view>
    </view>
  </block>

  <block wx:elif="{{role === 'drawer'}}">
    <view class="dg-tools">
      <view class="dg-tool" bindtap="clearBoard">🧽 清空重画</view>
      <view class="dg-tool" bindtap="giveUp">🔁 换个词</view>
    </view>
    <view class="dg-hint">你正在画给 TA 猜，TA 猜对就得分啦 ♡</view>
  </block>

  <block wx:else>
    <view class="dg-guess-row">
      <input class="dg-input" value="{{guess}}" bindinput="onGuess" placeholder="TA 画的是什么？" confirm-type="send" bindconfirm="submitGuess" />
      <view class="dg-send" bindtap="submitGuess">提交</view>
    </view>
    <view wx:if="{{status}}" class="dg-status">{{status}}</view>
  </block>
</view>
