.dg-page { padding: 24rpx 24rpx 50rpx; box-sizing: border-box; }

.dg-score { display: flex; align-items: center; justify-content: center; gap: 26rpx; margin-bottom: 18rpx; }
.dg-score-item { display: flex; flex-direction: column; align-items: center; min-width: 120rpx; }
.dg-num { font-size: 46rpx; font-weight: 900; color: #E14E68; line-height: 1.1; }
.dg-lbl { font-size: 22rpx; color: #B0797F; font-weight: 800; margin-top: 4rpx; }
.dg-vs { font-size: 26rpx; font-weight: 900; color: #C0A3A7; }

.dg-stage {
  position: relative; width: 100%; height: 620rpx; border-radius: 24rpx;
  background: #FFFDFE; overflow: hidden;
  border: 4rpx dashed #FBE0E4;
  box-shadow: inset 0 2rpx 8rpx rgba(225,120,140,.08), 0 10rpx 24rpx rgba(200,150,160,.14);
}
.dg-canvas { width: 100%; height: 100%; }
.dg-mask {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  font-size: 26rpx; font-weight: 800; color: #C9AEB2; white-space: nowrap;
}
.dg-badge {
  position: absolute; top: 16rpx; left: 50%; transform: translateX(-50%);
  font-size: 24rpx; font-weight: 800; color: #C9405A;
  background: rgba(255,236,241,.94); padding: 10rpx 26rpx; border-radius: 999rpx;
  box-shadow: 0 6rpx 14rpx rgba(225,120,140,.2); white-space: nowrap;
}
.dg-badge.guest { color: #5B8DEF; background: rgba(233,241,255,.94); }
.dg-badge-word { color: #E14E68; font-size: 28rpx; }

.dg-hint { margin-top: 18rpx; text-align: center; font-size: 23rpx; color: #B79A9E; font-weight: 700; }

.dg-words { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.dg-word-chip {
  flex: 1 1 28%; min-width: 150rpx; box-sizing: border-box; text-align: center;
  padding: 20rpx 8rpx; border-radius: 18rpx; font-size: 26rpx; font-weight: 800; color: #7A5A5F;
  background: linear-gradient(160deg, #FFFFFF, #FFEDF2);
  box-shadow: 0 8rpx 0 #F3D9E0, 0 12rpx 18rpx rgba(225,120,140,.16), inset 0 3rpx 0 #fff;
}
.dg-word-chip:active { transform: translateY(3rpx); box-shadow: 0 4rpx 0 #F3D9E0, 0 8rpx 12rpx rgba(225,120,140,.14); }

.dg-tools { display: flex; gap: 18rpx; margin-top: 22rpx; }
.dg-tool {
  flex: 1; text-align: center; padding: 22rpx 0; border-radius: 18rpx;
  font-size: 26rpx; font-weight: 800; color: #9A8589; background: #F3EEEB;
}

.dg-guess-row { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; }
.dg-input {
  flex: 1; height: 92rpx; line-height: 92rpx; padding: 0 26rpx; border-radius: 18rpx;
  background: #fff; font-size: 30rpx; font-weight: 800; color: #5C4448;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,.06), 0 8rpx 18rpx rgba(200,160,170,.16);
}
.dg-send {
  flex: none; width: 150rpx; height: 92rpx; line-height: 92rpx; text-align: center;
  border-radius: 18rpx; color: #fff; font-size: 28rpx; font-weight: 900;
  background: linear-gradient(135deg,#FF9FB6,#FF6F91 48%,#E14E68);
  box-shadow: 0 8rpx 0 #C43E59, 0 12rpx 20rpx rgba(225,78,104,.36);
}
.dg-send:active { transform: translateY(3rpx); box-shadow: 0 4rpx 0 #C43E59, 0 8rpx 14rpx rgba(225,78,104,.32); }

.dg-status { margin-top: 18rpx; text-align: center; font-size: 26rpx; font-weight: 800; color: #C9405A; }
